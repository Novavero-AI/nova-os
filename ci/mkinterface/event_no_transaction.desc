# Refused at line 36: an event that does not begin with a transaction.

# A description that breaks one rule.
interface event_no_transaction

# Not a header.
struct BAD
  u32 kind  # the message's
  u32 more  # more
end

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
    reply pong
  end

  # A reply.
  reply pong
    body HDR
  end

  # An event.
  event tick TICK 2
    body BAD
  end
end
