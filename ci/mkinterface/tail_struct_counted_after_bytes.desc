# Refused at line 32: a counted structure tail after a counted tail of bytes.

# A description that breaks one rule.
interface tail_struct_counted_after_bytes

# A pair of u64.
struct PAIR
  u64 a  # a
  u64 b  # b
end

# A body with a count.
struct NB
  u32 transaction  # the request's
  u32 kind  # the message's
  u32 n  # a count
  u8 small  # a small count
  u8 pad1  # pad
  u16 pad2  # pad
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body NB
    tail data bytes count n max 8  # the data
    tail pairs PAIR count n max 2  # the pairs
  end
end
