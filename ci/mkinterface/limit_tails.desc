# Refused at line 33: more than 8 tails in a message.

# A description that breaks one rule.
interface limit_tails

# A body with a count.
struct NB
  u32 transaction  # the request's
  u32 kind  # the message's
  u32 n  # a count
  u8 small  # a small count
  u8 pad1  # pad
  u16 pad2  # pad
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body NB
    tail t1 bytes count n max 8  # a tail
    tail t2 bytes count n max 8  # a tail
    tail t3 bytes count n max 8  # a tail
    tail t4 bytes count n max 8  # a tail
    tail t5 bytes count n max 8  # a tail
    tail t6 bytes count n max 8  # a tail
    tail t7 bytes count n max 8  # a tail
    tail t8 bytes count n max 8  # a tail
    tail t9 bytes count n max 8  # a tail
  end
end
