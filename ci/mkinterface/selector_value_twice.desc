# Refused at line 24: a value used twice in a direction.

# A description that breaks one rule.
interface selector_value_twice

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
  end

  # Another.
  request pong PONG 1
    body HDR
  end
end
