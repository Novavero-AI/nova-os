# Refused at line 24: a reply no request names.

# A description that breaks one rule.
interface reply_unnamed

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
  end

  # A reply.
  reply pong
    body HDR
  end
end
