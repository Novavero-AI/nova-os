# Refused at line 15: answer where a request has no reply.

# A description that breaks one rule.
interface policy_answer_no_reply

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server answer r
  invalid client close

  # A request.
  request ping PING 1
    body HDR
  end
end
