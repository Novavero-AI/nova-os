# Refused at line 25: a command named by two requests.

# A description that breaks one rule.
interface command_duplicate

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
    command go
  end

  # Another.
  request pong PONG 2
    body HDR
    command go
  end
end
