# Refused at line 32: the bytes after the body held by a field of a structure tail.

# A description that breaks one rule.
interface field_tails_on_tail

# A credential.
struct CRED
  u32 length  # the bytes after the body
  u32 pad = 0  # pad
end

# A body with a count.
struct NB
  u32 transaction  # the request's
  u32 kind  # the message's
  u32 n  # a count
  u8 small  # a small count
  u8 pad1  # pad
  u16 pad2  # pad
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body NB
    tail cred CRED  # the credential
    field cred.length = tails
  end
end
