# Refused at line 22: a request that names two replies.

# A description that breaks one rule.
interface reply_twice

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
    reply pong
    reply pang
  end

  # A reply.
  reply pong
    body HDR
  end
