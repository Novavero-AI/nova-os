# Refused at line 22: a channel line after a message.

# A description that breaks one rule.
interface channel_line_late

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
  end
  capacity PING
end
