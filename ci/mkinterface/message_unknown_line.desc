# Refused at line 21: an unknown line in a message.

# A description that breaks one rule.
interface message_unknown_line

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
    frobnicate
  end
end
