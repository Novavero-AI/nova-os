# Refused at line 22: two commands in a request.

# A description that breaks one rule.
interface command_twice

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
    command ping
    command pong
  end
end
