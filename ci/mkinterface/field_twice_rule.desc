# Refused at line 26: a field constrained twice.

# A description that breaks one rule.
interface field_twice_rule

# A body with a count.
struct NB
  u32 transaction  # the request's
  u32 kind  # the message's
  u32 n  # a count
  u8 small  # a small count
  u8 pad1  # pad
  u16 pad2  # pad
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body NB
    field n min 1
    field n max 8
  end
end
