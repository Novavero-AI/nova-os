# Refused at line 19: reply on the same channel.

# A description that breaks one rule.
interface reply_on_self

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  select kind
  invalid server close
  invalid client close

  # A request.
  request ping PING 1
    body HDR
    reply pong on c
  end

  # A reply.
  reply pong
    body HDR
  end
end
