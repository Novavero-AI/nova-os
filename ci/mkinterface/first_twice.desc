# Refused at line 13: two first messages in a direction.

# A description that breaks one rule.
interface first_twice

# The start of every message.
struct HDR
  u32 transaction  # the request's
  u32 kind         # the message's
end

# A channel.
channel c
  invalid server close
  invalid client close

  # A request.
  request ping
    body HDR
    first
  end

  # Another.
  request pong
